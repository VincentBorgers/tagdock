# One file per server container. ./tagdock add <site> copies this template.

# In Tag Manager, open the server container workspace, click the container ID,
# choose "Manually provision tagging server" and copy the Container Config.
CONTAINER_CONFIG=

# Domain for tagging requests, for example sgtm.example.com (PROXY=caddy).
TAGGING_DOMAIN=

# Domain for the preview server, for example sgtm-preview.example.com.
# Tag Manager's preview mode uses this server, so it must be reachable over HTTPS.
PREVIEW_DOMAIN=

# Host ports for PROXY=none. Your reverse proxy forwards to these.
TAGGING_PORT=
PREVIEW_PORT=

# Memory limits per container.
TAGGING_MEMORY=1g
PREVIEW_MEMORY=512m
