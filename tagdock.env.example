# Copy this file to tagdock.env and adjust it.

# caddy: Caddy listens on ports 80 and 443 and gets certificates from Let's Encrypt.
# none:  the containers listen on LISTEN_ADDRESS and you put your own reverse proxy in front.
PROXY=caddy

# Email address for Let's Encrypt expiry notices (PROXY=caddy, optional).
ACME_EMAIL=

# Address the published ports bind to. Defaults to all interfaces with PROXY=caddy
# and to 127.0.0.1 with PROXY=none.
LISTEN_ADDRESS=

# Ports Caddy publishes on the host (PROXY=caddy).
HTTP_PORT=80
HTTPS_PORT=443

# Use Caddy's internal CA instead of Let's Encrypt. Only for testing.
CADDY_LOCAL_CERTS=false

# Docker Compose project name. Change it to run more than one copy on a host.
COMPOSE_PROJECT=tagdock

# Images. The tagging server image is the one Google publishes.
SGTM_IMAGE=gcr.io/cloud-tagging-10302018/gtm-cloud-image:stable
CADDY_IMAGE=caddy:2
